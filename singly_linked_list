void reverse(){
    struct Node* prev=NULL;
    struct Node* curr=NULL;
    if(head!=NULL){
        prev=head;
        curr=head->next;
        head=head->next;
        
        prev->next=NULL;
    }
    while(head!=NULL){
        head=head->next;
        curr->next=prev;
        prev=curr;
        curr=head;
    }
    head=prev;
    printf("susess!!\n");
}
